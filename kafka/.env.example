# Confluent Platform 7.9.x = Apache Kafka 3.9, la última línea que funciona con ZooKeeper.
CP_VERSION=7.9.8
KAFKA_UI_VERSION=v1.5.0

# Dirección con que los brokers se anuncian a los clientes de FUERA de este compose.
#   Local: host.docker.internal  (llegan igual los contenedores de infra/apps y el IDE del PC;
#          con "localhost" los contenedores de apps no encuentran al broker)
#   AWS:   IP privada de ec2-kafka (no cambia al reiniciar el laboratorio)
KAFKA_HOST=host.docker.internal

# Kafka UI permite borrar tópicos: siempre con usuario y clave (solo letras y números).
KAFKA_UI_USER=vidasalud
KAFKA_UI_PASS=
